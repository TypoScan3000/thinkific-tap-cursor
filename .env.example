# Cursor Admin API Configuration
# Copy this file to .env and fill in your actual values

# Required: Your Cursor Admin API key
TAP_CURSOR_API_KEY=your_cursor_admin_api_key_here

# Optional: Cursor Admin API base URL (defaults to https://api.cursor.com)
TAP_CURSOR_API_URL=https://api.cursor.com

# Optional: Start date for data extraction (ISO 8601 format)
# Defaults to 30 days ago if not specified
TAP_CURSOR_START_DATE=2024-01-01T00:00:00Z

# Optional: End date for data extraction (ISO 8601 format)
# Defaults to today if not specified
TAP_CURSOR_END_DATE=2024-01-31T23:59:59Z

# Optional: Custom User-Agent header
TAP_CURSOR_USER_AGENT=tap-cursor/1.0.0
